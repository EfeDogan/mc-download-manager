    "Clear": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Temizle"
          }
        }
      }
    },
    "Listening on 127.0.0.1:%@": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "127.0.0.1:%@ dinleniyor"
          }
        }
      }
    },
    "Error: %1$@ (port %2$@ may be in use)": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Hata: %1$@ (port %2$@ kullanımda olabilir)"
          }
