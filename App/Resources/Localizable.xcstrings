        }
      }
    },
    "Format": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Format"
          }
        }
      }
    },
    "yt-dlp -f value": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "yt-dlp -f değeri"
          }
        }
      }
    },
    "Examples: bv*+ba/b (best), bv*[height<=1080]+ba/b (up to 1080p), ba (audio only)": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Örnekler: bv*+ba/b (en iyi), bv*[height<=1080]+ba/b (1080p'ye kadar), ba (yalnızca ses)"
          }
        }
      }
    },
    "This download was removed from the list.": {
      "localizations": {
        "tr": {
          "stringUnit": {
