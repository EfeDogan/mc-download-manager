{
  "authorizationCases": [
    {
      "name": "extension origin and loopback host",
      "headers": {
        "origin": "chrome-extension://abcdefghijklmnop",
        "host": "127.0.0.1:48213",
        "x-mcdm-extension": "chrome"
      },
      "allowed": true
    },
    {
      "name": "Chrome GET without Origin but with marker",
      "headers": {
        "host": "localhost:48213",
        "x-mcdm-extension": "chrome"
      },
      "allowed": true
    },
    {
      "name": "Firefox extension origin",
      "headers": {
        "origin": "moz-extension://12345678-1234-1234-1234-123456789abc",
        "host": "127.0.0.1:48213",
        "x-mcdm-extension": "firefox"
      },
      "allowed": true
    },
    {
      "name": "ordinary web origin with forged marker",
      "headers": {
        "origin": "https://example.com",
        "host": "127.0.0.1:48213",
        "x-mcdm-extension": "chrome"
      },
      "allowed": false
    },
    {
      "name": "opaque null origin",
      "headers": {
        "origin": "null",
        "host": "127.0.0.1:48213",
        "x-mcdm-extension": "firefox"
      },
      "allowed": false
    },
    {
      "name": "missing marker and origin",
      "headers": { "host": "127.0.0.1:48213" },
      "allowed": false
    },
    {
      "name": "non-loopback Host",
      "headers": {
        "origin": "chrome-extension://abcdefghijklmnop",
        "host": "example.com:48213",
        "x-mcdm-extension": "chrome"
      },
      "allowed": false
    },
    {
      "name": "wrong port",
      "headers": {
        "origin": "chrome-extension://abcdefghijklmnop",
        "host": "127.0.0.1:9999",
        "x-mcdm-extension": "chrome"
      },
      "allowed": false
    }
  ],
  "requests": [
    {
      "name": "file download with browser context",
      "method": "POST",
      "path": "/download",
      "body": {
        "url": "https://downloads.example.test/archive.zip",
