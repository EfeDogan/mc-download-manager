        "referer": "https://example.test/files",
        "userAgent": "Contract Fixture Browser",
        "cookieHeader": "",
        "cookies": [],
        "kind": "file",
        "segments": 8
      }
    },
    {
      "name": "video download",
      "method": "POST",
      "path": "/download",
      "body": {
        "url": "https://video.example.test/watch/42",
        "filename": "",
        "referer": "https://video.example.test/watch/42",
        "kind": "video",
        "videoQuality": "720p"
